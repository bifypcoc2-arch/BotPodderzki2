BOT_TOKEN=your_bot_token_here
DATABASE_URL=sqlite+aiosqlite:///./bot.db
FORUM_GROUP_ID=your_forum_group_id
MINI_APP_URL=https://your-domain.com/miniapp

# Queue settings
QUEUE_WAIT_MINUTES=5

# Broadcast settings
BROADCAST_TIMEOUT_MINUTES=10
BROADCAST_DELAY_MS=50

# Web server settings (Mini App API)
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Database
DATABASE_ECHO=false

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Backups
BACKUP_ENABLED=true
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28

# Anti-spam (private chats only)
ANTISPAM_ENABLED=true
ANTISPAM_WINDOW_SECONDS=15
ANTISPAM_MAX_MESSAGES=6
ANTISPAM_BLOCK_SECONDS=60

# Alerts to owners
ALERTS_ENABLED=true
ALERT_REPEAT_MINUTES=30
ALERT_ON_START=false

# Bot state storage
STATE_FILE=data/states.pkl
